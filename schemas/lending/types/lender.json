{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viaschema.com/schemas/lending/types/lender.json",
  "title": "Lender",
  "description": "A lending institution that offers loans.",
  "type": "object",
  "required": ["lender_name", "loan_types_offered", "platform_id"],
  "additionalProperties": true,
  "properties": {
    "lender_name": {
      "type": "string",
      "description": "Display name of the lender."
    },
    "loan_types_offered": {
      "type": "array",
      "description": "Loan types this lender supports.",
      "items": {
        "type": "string",
        "enum": ["personal", "car"]
      }
    },
    "description": {
      "type": "string",
      "description": "Short description of the lender."
    },
    "platform_id": {
      "type": "string",
      "description": "Unique platform identifier used for token scoping."
    }
  }
}
