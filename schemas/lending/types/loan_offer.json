{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viaschema.com/schemas/lending/types/loan_offer.json",
  "title": "LoanOffer",
  "description": "A loan offer from a lender, generated from the borrower's PII and loan application details.",
  "type": "object",
  "required": ["lender_name", "rate", "amount", "term_months", "monthly_payment", "continue_url"],
  "additionalProperties": true,
  "properties": {
    "lender_name": {
      "type": "string",
      "description": "Name of the lender making the offer."
    },
    "rate": {
      "type": "number",
      "description": "Annual interest rate (APR) as a percentage."
    },
    "amount": {
      "type": "number",
      "description": "Loan amount in dollars."
    },
    "term_months": {
      "type": "integer",
      "description": "Loan term in months."
    },
    "monthly_payment": {
      "type": "number",
      "description": "Estimated monthly payment in dollars."
    },
    "continue_url": {
      "type": "string",
      "format": "uri",
      "description": "URL for the borrower to continue the application with this lender."
    }
  }
}
