{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viaschema.com/schemas/lending/lending.json",
  "name": "com.viaschema.lending",
  "title": "Lending Extension",
  "description": "Extends Checkout with loan application support — lender search, PII collection/consent, multi-lender offer comparison. PII is handled via a separate PII handler; the lending handler is PII-agnostic.",
  "$defs": {
    "lender": {
      "$ref": "types/lender.json"
    },
    "loan_offer": {
      "$ref": "types/loan_offer.json"
    },
    "loan_type": {
      "$ref": "types/loan_type.json"
    },
    "lending_handler": {
      "$ref": "types/lending_handler.json"
    },
    "lending_response": {
      "$ref": "types/lending_response.json"
    },
    "dev.ucp.shopping.checkout": {
      "title": "Checkout with Lending",
      "description": "Checkout extended with lending application support.",
      "allOf": [
        {
          "$ref": "https://ucp.dev/schemas/shopping/checkout.json"
        },
        {
          "type": "object",
          "properties": {
            "lending": {
              "$ref": "#/$defs/lending_response",
              "description": "Lending application details.",
              "ucp_request": {
                "create": "optional",
                "update": "optional",
                "complete": "omit"
              }
            }
          }
        }
      ]
    },
    "com.viaschema.lending": {
      "platform_schema": {
        "title": "Lending Capability (Platform)",
        "description": "Platform-level lending handler configuration. Declares lending marketplaces the merchant supports.",
        "allOf": [
          {
            "$ref": "https://ucp.dev/schemas/capability.json#/$defs/platform_schema"
          },
          {
            "properties": {
              "handlers": {
                "type": "array",
                "items": { "$ref": "#/$defs/lending_handler" },
                "description": "Lending handlers supported by the merchant."
              }
            }
          }
        ]
      },
      "business_schema": {
        "title": "Lending Capability (Business)",
        "description": "Business-level lending configuration.",
        "allOf": [
          {
            "$ref": "https://ucp.dev/schemas/capability.json#/$defs/business_schema"
          },
          {
            "properties": {
              "config": {
                "type": "object",
                "description": "Business lending configuration."
              }
            }
          }
        ]
      }
    }
  },
  "embedded": {
    "methods": [
      {
        "name": "ec.lending.start",
        "summary": "Start lending flow",
        "description": "Initialize the lending extension on the checkout with PII handlers, required fields, and available lenders.",
        "params": [
          {
            "name": "loan_type",
            "required": true,
            "schema": { "$ref": "#/$defs/loan_type" }
          },
          {
            "name": "user_email",
            "required": true,
            "schema": { "type": "string", "format": "email", "description": "Customer email for PII lookup." }
          }
        ],
        "result": {
          "name": "lendingStartResult",
          "schema": {
            "type": "object",
            "required": ["checkout"],
            "properties": {
              "checkout": {
                "$ref": "#/$defs/dev.ucp.shopping.checkout",
                "description": "Checkout with initialized lending state."
              }
            }
          }
        }
      },
      {
        "name": "ec.lending.submit",
        "summary": "Submit loan application",
        "description": "Submit PII instruments and non-PII data to all eligible lenders. Returns aggregated offers sorted by rate.",
        "params": [
          {
            "name": "pii_instruments",
            "required": true,
            "schema": {
              "type": "array",
              "items": { "$ref": "https://viaschema.com/schemas/pii/types/pii_instrument.json" },
              "description": "Platform-scoped PII instruments from consent flow."
            }
          },
          {
            "name": "loan_application",
            "required": true,
            "schema": {
              "type": "object",
              "description": "Non-PII loan application data (loan amount, vehicle details, etc.).",
              "additionalProperties": true
            }
          }
        ],
        "result": {
          "name": "loanOffersResult",
          "schema": {
            "type": "object",
            "required": ["offers"],
            "properties": {
              "offers": {
                "type": "array",
                "items": { "$ref": "#/$defs/loan_offer" },
                "description": "Loan offers from all eligible lenders, sorted by rate ascending."
              },
              "checkout": {
                "$ref": "#/$defs/dev.ucp.shopping.checkout",
                "description": "Updated checkout with offers."
              }
            }
          }
        }
      },
      {
        "name": "ec.lending.lenders",
        "summary": "List available lenders",
        "description": "Returns available lenders, optionally filtered by loan type.",
        "params": [
          {
            "name": "loan_type",
            "required": false,
            "schema": { "$ref": "#/$defs/loan_type" }
          }
        ],
        "result": {
          "name": "lendersResult",
          "schema": {
            "type": "object",
            "required": ["lenders"],
            "properties": {
              "lenders": {
                "type": "array",
                "items": { "$ref": "#/$defs/lender" },
                "description": "Available lenders."
              }
            }
          }
        }
      }
    ]
  }
}
