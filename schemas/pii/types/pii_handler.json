{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viaschema.com/schemas/pii/types/pii_handler.json",
  "title": "PIIHandler",
  "description": "A PII handler from the merchant's UCP profile. Represents a trusted third-party PII provider (e.g., VGS, OneTrust) that can securely collect, store, and deliver user PII.",
  "type": "object",
  "required": ["id", "name"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "description": "Handler identifier (e.g., 'vgs_pii_provider')."
    },
    "name": {
      "type": "string",
      "description": "Handler dotted name (e.g., 'vgs.pii.provider')."
    },
    "version": {
      "type": "string",
      "description": "Handler version."
    },
    "spec": {
      "type": "string",
      "format": "uri",
      "description": "Handler specification URL."
    },
    "config_schema": {
      "type": "string",
      "format": "uri",
      "description": "Handler config schema URL."
    },
    "config": {
      "type": "object",
      "description": "Handler configuration. Contents are provider-specific.",
      "additionalProperties": true
    }
  }
}
