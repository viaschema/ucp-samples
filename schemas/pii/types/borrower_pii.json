{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viaschema.com/schemas/pii/types/borrower_pii.json",
  "title": "BorrowerPII",
  "description": "Complete borrower PII model for lending applications. Composes UCP canonical Buyer fields with finance-specific fields.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Borrower's first name."
    },
    "last_name": {
      "type": "string",
      "description": "Borrower's last name."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Borrower's email address."
    },
    "phone_number": {
      "type": "string",
      "description": "Borrower's phone number (E.164 format)."
    },
    "address": {
      "$ref": "https://ucp.dev/schemas/shopping/types/postal_address.json",
      "description": "Borrower's postal address."
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth (ISO 8601, e.g., 1990-01-15)."
    },
    "annual_income": {
      "type": "string",
      "description": "Annual income in dollars."
    },
    "living_situation": {
      "type": "string",
      "enum": ["rent", "fully_own", "mortgage"],
      "description": "Housing status."
    },
    "monthly_housing_payment": {
      "type": "string",
      "description": "Monthly housing cost in dollars."
    },
    "employment_status": {
      "type": "string",
      "enum": ["employed", "self_employed", "unemployed", "retired"],
      "description": "Employment status."
    },
    "employer_phone_number": {
      "type": "string",
      "description": "Employer phone number (E.164 format)."
    },
    "employer_address": {
      "$ref": "https://ucp.dev/schemas/shopping/types/postal_address.json",
      "description": "Employer's postal address."
    }
  }
}
