# Shared secret sent as `Authorization: Bearer <key>` to the backend.
# Must match API_SECRET_KEY set on the business_agent service.
VITE_API_KEY=replace-with-shared-secret

# Backend origin. Leave unset for local dev (Vite proxy handles /api).
# For Vercel builds, point at the deployed Render service, e.g.:
# VITE_API_BASE_URL=https://your-service.onrender.com
VITE_API_BASE_URL=
