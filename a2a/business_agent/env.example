GOOGLE_API_KEY=<your gemini api key>
VGS_VAULT_ID=<your vgs vault id>
VGS_USERNAME=<your vgs runtime username>
VGS_PASSWORD=<your vgs runtime password>
VGS_ENVIRONMENT=sandbox
LENDER_API_BASE=https://<your-ngrok-id>.ngrok-free.app/lender-api
# Shared secret the frontend must send as `Authorization: Bearer <key>`.
# Leave empty to disable auth (dev only).
API_SECRET_KEY=<shared-secret-matching-VITE_API_KEY>
# Comma-separated list of additional allowed CORS origins (e.g. Vercel URL).
FRONTEND_ORIGIN=https://<your-vercel-project>.vercel.app